{
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ambassadors",
      "destination": "https://supercomp.bucis.org/ambassador",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://supercomp.bucis.org/:path*",
      "permanent": true
    }
  ]
}